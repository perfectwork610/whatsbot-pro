{
  "name": "whatsbot-pro",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "tsc --noEmit",
    "worker": "node --env-file=.env.local scripts/worker.mjs",
    "typecheck": "tsc --noEmit",
    "setup": "node scripts/setup.mjs",
    "test": "node scripts/test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:imports": "node scripts/contact-import-test.mjs",
    "outreach:worker": "node --env-file=.env.local scripts/outreach-worker.mjs",
    "test:outreach": "node scripts/outreach-migration-test.mjs && node scripts/outreach-engine-test.mjs && node scripts/outreach-lifecycle-test.mjs"
  },
  "dependencies": {
    "@tailwindcss/forms": "^0.5.10",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^16.4.6",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0",
    "whatsapp-web.js": "^1.34.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prettier": "^3.10.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "whatsapp-web.js": {
      "puppeteer": "25.17.0"
    },
    "archiver-utils": {
      "glob": "14.0.2"
    }
  }
}
