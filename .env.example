# Copy to .env.local. Never commit .env.local.
WHATSAPP_MODE=simulation
ADMIN_PASSWORD=replace-with-a-long-random-password
WORKER_SECRET=replace-with-another-long-random-secret
# Exact browser origin, no trailing slash.
# Local: http://localhost:3000
# Vercel: https://your-app.vercel.app  (must match the URL you open in the browser)
APP_URL=http://localhost:3000
# Optional. On Vercel, omit this so data uses ephemeral /tmp (not durable).
# DATA_DIR=
# Live mode only: use the active Graph version configured for your Meta app.
META_GRAPH_VERSION=
META_APP_SECRET=
META_VERIFY_TOKEN=
WA_TOKEN_PRIMARY=
